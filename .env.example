# Discovery Hub configuration - ONE file for the whole project.
#
# This is the single source of truth for every module: the ingestion service,
# the search service and the corpus generator all read from here. There are
# deliberately no per-module .env files.
#
# Copy to .env and fill in real values. .env is git-ignored and must never be
# committed. Docker Compose reads .env from the infrastructure directory, so
# either place your copy there or symlink it:
#
#   cp .env.example .env
#   ln -s ../.env infrastructure/.env
#
# Every value below has a working default in the services, so an empty .env
# still starts a fully local stack against the Compose containers.

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
# Deliberately separate variables so one shared file cannot hand both
# services the same port.
INGESTION_PORT=8081
SEARCH_PORT=8082
CASE_HOLD_PORT=8083
EXPORT_PORT=8084

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local container (default when unset):
#   mongodb://mongodb:27017/legal_discovery      (from inside Docker)
#   mongodb://localhost:27017/legal_discovery    (from the host)
# Atlas cluster:
#   mongodb+srv://<username>:<password>@<cluster-host>/legal_discovery?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/legal_discovery

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# kafka:19092 from inside Docker, localhost:9092 from the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_LISTENER_CONCURRENCY=3
CASE_HOLD_TOPIC=case-hold.events

# ---------------------------------------------------------------------------
# Object storage - archival bucket for attachment binaries
# ---------------------------------------------------------------------------
# Two supported setups; see docs/s3-archival.md for retrieval and IAM details.
#
# Local MinIO (values below):
#   S3_ENDPOINT=http://minio:9000, S3_PATH_STYLE_ACCESS=true, S3_CREATE_BUCKET=true
#
# Real AWS S3 archival bucket:
#   S3_BUCKET=<your-archival-bucket>
#   S3_ENDPOINT=                  (empty)
#   S3_PATH_STYLE_ACCESS=false
#   S3_CREATE_BUCKET=false
#   AWS_REGION must match the bucket, or S3 fails with PermanentRedirect.
#   Check it with:
#     curl -sI https://<bucket>.s3.amazonaws.com | grep -i x-amz-bucket-region
S3_BUCKET=discovery-hub-attachments
S3_ENDPOINT=http://minio:9000
S3_PATH_STYLE_ACCESS=true
S3_CREATE_BUCKET=true
# Optional: browser-facing URL when it differs from the internal endpoint.
S3_PUBLIC_BASE_URL=http://localhost:9000

# Bucket that holds generated export packages (written by the export service).
S3_EXPORT_BUCKET=discovery-hub-exports
# Lifetime of a presigned export download URL, in seconds.
EXPORT_DOWNLOAD_EXPIRY_SECONDS=900

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>

# MinIO root credentials for the local container. Must match the AWS_* values
# above when S3_ENDPOINT points at MinIO.
MINIO_ROOT_USER=<your-minio-user>
MINIO_ROOT_PASSWORD=<your-minio-password>

# ---------------------------------------------------------------------------
# PostgreSQL (case-hold service)
# ---------------------------------------------------------------------------
# postgres:5432 from inside Docker, localhost:5432 from the host.
POSTGRES_DB=case_hold
POSTGRES_USER=casehold
POSTGRES_PASSWORD=casehold
# Override the full JDBC URI if you need a non-container database.
# POSTGRES_URI=jdbc:postgresql://postgres:5432/case_hold

# ---------------------------------------------------------------------------
# Elasticsearch (search service)
# ---------------------------------------------------------------------------
# elasticsearch:9200 from inside Docker, localhost:9200 from the host.
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
SEARCH_INDEX=messages
SEARCH_RECONCILE_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Ingestion behaviour
# ---------------------------------------------------------------------------
OUTBOX_INTERVAL_MS=15000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Retention and disposition (ingestion service)
# ---------------------------------------------------------------------------
# Disposition permanently deletes messages and their S3 objects, so it is off
# by default and must be switched on per environment.
DISPOSITION_ENABLED=false
# Report what would be deleted without deleting anything.
DISPOSITION_DRY_RUN=false

# Retention period per communication type, as Spring Durations
# (2555d = 7 years, 1095d = 3 years, and 30s / 1m / 24h also parse).
RETENTION_EMAIL=2555d
RETENTION_CHAT=1095d
RETENTION_DEFAULT=2555d

# The service refuses to start with a period below this floor unless short
# retention is explicitly allowed, so a demo value cannot reach real data.
RETENTION_MIN_PERIOD=24h
ALLOW_SHORT_RETENTION=false

DISPOSITION_INTERVAL_MS=60000
DISPOSITION_BATCH_SIZE=200
# Ceiling on deletions in one run, so a misconfigured period cannot empty the
# collection in a single sweep.
DISPOSITION_MAX_DELETES=500
PURGE_SWEEP_INTERVAL_MS=60000

# One-minute demo (see docs/retention-and-holds.md). Deletes anything ingested
# a minute later, so never enable this against data you want to keep:
#   DISPOSITION_ENABLED=true
#   ALLOW_SHORT_RETENTION=true
#   RETENTION_EMAIL=1m
#   RETENTION_CHAT=1m
#   DISPOSITION_INTERVAL_MS=10000

# ---------------------------------------------------------------------------
# Corpus generator
# ---------------------------------------------------------------------------
# CLI flags always take precedence over these defaults.
API_URL=http://localhost:8081
CORPUS_MESSAGES=10000
CORPUS_CUSTODIANS=25
CORPUS_RATE=20
CORPUS_OUTPUT=generated-corpus
CORPUS_SEED=42

CORPUS_EMAIL_RATIO=0.65
CORPUS_ATTACHMENT_RATE=0.08
CORPUS_WINDOW_DAYS=365
CORPUS_WORKERS=4
CORPUS_TIMEOUT=30
CORPUS_MAX_ATTACHMENT_BYTES=1048576

# Only used with --upload-to-s3
CORPUS_S3_PREFIX=corpus-attachments
